# SchollyJob — Apache clean-URL config
# Use this file ONLY if your host runs Apache (most cPanel/shared hosting).
# It makes /scholarships load scholarships.html, /fully-funded-scholarships-2026
# load fully-funded-scholarships-2026.html, etc., matching every internal link,
# the sitemap, and the canonical tags already in these pages.
# If your host is Netlify, Vercel, or Nginx, delete this file and use the
# matching config included instead (_redirects / vercel.json / nginx.conf.txt).

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Force non-www (canonical tags use https://schollyjob.com/ without www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# If a request comes in for foo.html, redirect (not rewrite) it permanently
# to /foo so there is exactly one canonical URL per page.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the .html file when the extensionless URL is requested.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Homepage
DirectoryIndex index.html

# Custom 404 (optional — create a 404.html for a branded not-found page)
# ErrorDocument 404 /404.html

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
</IfModule>
